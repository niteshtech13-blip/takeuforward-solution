from collections import Counter

class Solution:
    def threeSum(self, nums: list) -> list[list]:
        counts = Counter(nums)
        values = list(counts.keys())
        triples = set()

        for i in range(len(values)):
            for j in range(i, len(values)):
                first = values[i]
                second = values[j]
                third = -first - second

                if third not in counts:
                    continue

                needed = Counter([first, second, third])
                if all(counts[value] >= amount for value, amount in needed.items()):
                    triples.add(tuple(sorted((first, second, third))))

        return [list(triple) for triple in sorted(triples)]
