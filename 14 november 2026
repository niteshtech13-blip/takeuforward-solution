

class Solution {
public:
    vector<int> anagramMappings(vector<int>& nums1,
                                vector<int>& nums2) {

        int n = nums1.size();

        vector<int> ans;
        vector<bool> used(n, false);

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (nums1[i] == nums2[j] && !used[j]) {

                    ans.push_back(j);

                    used[j] = true;

                    break;
                }
            }
        }

        return ans;
    }
};
