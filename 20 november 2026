class Solution:
    def trap(self, height):
        stack = []
        total_water = 0

        for right in range(len(height)):
            while stack and height[right] > height[stack[-1]]:
                middle = stack.pop()

                if not stack:
                    break

                left = stack[-1]
                width = right - left - 1
                bounded_height = min(height[left], height[right]) - height[middle]
                total_water += width * bounded_height

            stack.append(right)

        return total_water
